<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Регистрация — Задачник</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
            background: #f5f5f7;
            color: #1d1d1f;
            min-height: 100vh;
            display: flex; align-items: center; justify-content: center;
            padding: 24px 16px;
            -webkit-font-smoothing: antialiased;
        }

        .auth-wrap { width: 100%; max-width: 360px; }

        .brand {
            text-align: center; margin-bottom: 28px;
        }
        .brand-icon {
            font-size: 48px; line-height: 1;
            background: linear-gradient(145deg, #0071e3, #40a9ff);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .brand-name {
            font-size: 26px; font-weight: 700; margin-top: 8px; color: #1d1d1f;
        }

        .auth-card {
            background: #fff; border-radius: 18px;
            box-shadow: 0 2px 20px rgba(0,0,0,.08);
            padding: 32px;
        }

        .auth-title { font-size: 20px; font-weight: 700; margin-bottom: 22px; }

        .field { margin-bottom: 16px; }
        .field-label {
            display: block; font-size: 13px; font-weight: 600;
            color: #6e6e73; margin-bottom: 6px;
            text-transform: uppercase; letter-spacing: .04em;
        }
        .field-input {
            width: 100%;
            border: 1px solid #d2d2d7; border-radius: 10px;
            padding: 10px 14px; font-size: 15px; color: #1d1d1f;
            background: #fff; outline: none; font-family: inherit;
            transition: border-color .15s, box-shadow .15s;
        }
        .field-input:focus {
            border-color: #0071e3;
            box-shadow: 0 0 0 3px rgba(0,113,227,.15);
        }

        .alert {
            border-radius: 10px; padding: 10px 14px;
            font-size: 14px; margin-bottom: 16px;
        }
        .alert-error { background: #fff2f2; color: #ff3b30; border: 1px solid rgba(255,59,48,.2); }

        .btn-submit {
            width: 100%; margin-top: 8px;
            background: #0071e3; color: #fff;
            border: none; border-radius: 980px;
            padding: 12px; font-size: 15px; font-weight: 600;
            cursor: pointer; font-family: inherit;
            transition: opacity .15s;
        }
        .btn-submit:hover { opacity: .85; }

        .auth-link {
            text-align: center; margin-top: 18px;
            font-size: 14px; color: #6e6e73;
        }
        .auth-link a { color: #0071e3; text-decoration: none; }
        .auth-link a:hover { text-decoration: underline; }
    </style>
</head>
<body>

<div class="auth-wrap">
    <div class="brand">
        <div class="brand-icon">✓</div>
        <div class="brand-name">Задачник</div>
    </div>

    <div class="auth-card">
        <div class="auth-title">Регистрация</div>

        {{#error}}
        <div class="alert alert-error">{{error}}</div>
        {{/error}}

        <form action="/register" method="post">
            <div class="field">
                <label class="field-label">Логин</label>
                <input type="text" name="username" class="field-input"
                       placeholder="Придумайте логин" autofocus required>
            </div>
            <div class="field">
                <label class="field-label">Пароль</label>
                <input type="password" name="password" class="field-input"
                       placeholder="Минимум 4 символа" required>
            </div>
            <div class="field">
                <label class="field-label">Повторите пароль</label>
                <input type="password" name="passwordConfirm" class="field-input"
                       placeholder="Повторите пароль" required>
            </div>
            <button type="submit" class="btn-submit">Создать аккаунт</button>
        </form>
    </div>

    <div class="auth-link">
        Уже есть аккаунт? <a href="/login">Войти</a>
    </div>
</div>

</body>
</html>