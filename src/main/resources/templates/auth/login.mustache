<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Вход — Задачник</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        body { background-color: #f0f2f5; }
        .auth-card { border: none; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,.1); }
        .brand-icon { font-size: 2.5rem; }
    </style>
</head>
<body class="d-flex align-items-center min-vh-100">

<div class="container">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-8 col-md-5 col-lg-4">

            <div class="text-center mb-4">
                <div class="brand-icon text-primary"><i class="bi bi-check2-square"></i></div>
                <h4 class="fw-bold mt-2">Задачник</h4>
            </div>

            <div class="card auth-card p-4">
                <h5 class="fw-semibold mb-4">Вход</h5>

                {{#error}}
                <div class="alert alert-danger py-2 small">{{error}}</div>
                {{/error}}
                {{#message}}
                <div class="alert alert-success py-2 small">{{message}}</div>
                {{/message}}

                <form action="/login" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-medium">Логин</label>
                        <input type="text" name="username" class="form-control"
                               placeholder="Введите логин" autofocus required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Пароль</label>
                        <input type="password" name="password" class="form-control"
                               placeholder="Введите пароль" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mb-3">Войти</button>
                </form>
            </div>

            <div class="text-center mt-3 small text-muted">
                Нет аккаунта? <a href="/register">Зарегистрироваться</a>
            </div>

        </div>
    </div>
</div>

</body>
</html>