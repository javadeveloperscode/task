<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Задачи</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        body { background-color: #f0f2f5; }
        .card { border: none; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,.08); }
        .stat-card { transition: transform .15s; }
        .stat-card:hover { transform: translateY(-2px); }
        .section-title { font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }

        /* Таблица */
        .task-row.overdue td { background-color: #fff5f5; }
        .task-row.done-row td { opacity: .6; }
        .time-inline { width: 90px; display: inline-block; font-size: .8rem; padding: 2px 6px; }
        .status-select { border-radius: 20px; font-size: .8rem; font-weight: 500; cursor: pointer; min-width: 130px; }
        .status-TODO { border-color: #6c757d; color: #6c757d; }
        .status-IN_PROGRESS { border-color: #0d6efd; color: #0d6efd; }
        .status-DONE { border-color: #198754; color: #198754; }

        /* Мобильные карточки */
        .task-card { border-radius: 12px; border: none; box-shadow: 0 1px 6px rgba(0,0,0,.07); }
        .task-card.overdue { border-left: 3px solid #dc3545 !important; }
        .task-card.done-card { opacity: .65; }
    </style>
</head>
<body>

<nav class="navbar navbar-dark bg-primary shadow-sm">
    <div class="container">
        <span class="navbar-brand fw-semibold">
            <i class="bi bi-check2-square me-2"></i>Задачник
        </span>
        <div class="d-flex gap-2">
            <a href="/tasks/new?type=GLOBAL" class="btn btn-light btn-sm">
                <i class="bi bi-globe2"></i>
                <span class="d-none d-sm-inline ms-1">Глобальная</span>
            </a>
            <a href="/tasks/new?type=DAILY" class="btn btn-light btn-sm">
                <i class="bi bi-plus-lg"></i>
                <span class="d-none d-sm-inline ms-1">Дневная</span>
            </a>
            <a href="/logout" class="btn btn-outline-light btn-sm">
                <i class="bi bi-box-arrow-right"></i>
                <span class="d-none d-sm-inline ms-1">Выйти</span>
            </a>
        </div>
    </div>
</nav>

<div class="container py-3 py-md-4">

    <!-- Статистика -->
    <div class="row g-2 g-md-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card stat-card text-center p-2 p-md-3">
                <div class="fs-3 fw-bold text-secondary">{{todoCount}}</div>
                <div class="text-muted small">К выполнению</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card text-center p-2 p-md-3">
                <div class="fs-3 fw-bold text-primary">{{inProgressCount}}</div>
                <div class="text-muted small">В работе</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card text-center p-2 p-md-3">
                <div class="fs-3 fw-bold text-success">{{doneCount}}</div>
                <div class="text-muted small">Готово</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card text-center p-2 p-md-3">
                <div class="fs-3 fw-bold text-danger">{{overdueCount}}</div>
                <div class="text-muted small">Просрочено</div>
            </div>
        </div>
    </div>

    <!-- ===== ГЛОБАЛЬНЫЕ ЗАДАЧИ ===== -->
    <div class="d-flex align-items-center justify-content-between mb-2">
        <span class="section-title text-secondary"><i class="bi bi-globe2 me-1"></i>Глобальные задачи</span>
        <a href="/tasks/new?type=GLOBAL" class="btn btn-sm btn-outline-secondary py-0">
            <i class="bi bi-plus-lg"></i>
        </a>
    </div>

    {{^hasGlobalTasks}}
    <div class="card mb-4">
        <div class="text-center py-4 text-muted small">
            <i class="bi bi-globe2 d-block fs-4 mb-1"></i>Нет глобальных задач
        </div>
    </div>
    {{/hasGlobalTasks}}

    {{#hasGlobalTasks}}
    <!-- Десктоп -->
    <div class="card mb-4 d-none d-md-block">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Задача</th>
                        <th>Дедлайн</th>
                        <th>Статус</th>
                        <th class="text-end pe-3">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    {{#globalTasks}}
                    <tr class="task-row {{#overdue}}overdue{{/overdue}} {{#done}}done-row{{/done}}">
                        <td class="ps-3">
                            <div class="fw-semibold">{{title}}</div>
                            {{#description}}
                            <div class="text-muted small text-truncate" style="max-width:400px">{{description}}</div>
                            {{/description}}
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-1">
                                {{#endDateOnly}}
                                {{#overdue}}
                                <span class="text-danger fw-semibold small">
                                    <i class="bi bi-exclamation-circle me-1"></i>{{endDateOnly}}
                                </span>
                                {{/overdue}}
                                {{^overdue}}
                                <span class="text-muted small">{{endDateOnly}}</span>
                                {{/overdue}}
                                <form action="/tasks/{{id}}/end-time" method="post" class="d-inline">
                                    <input type="time" name="time" value="{{endTime}}"
                                           class="form-control form-control-sm time-inline {{#overdue}}border-danger{{/overdue}}"
                                           onchange="this.form.submit()">
                                </form>
                                {{/endDateOnly}}
                                {{^endDateOnly}}<span class="text-muted small">—</span>{{/endDateOnly}}
                            </div>
                        </td>
                        <td>
                            <form action="/tasks/{{id}}/status" method="post" class="d-inline">
                                <select name="status" class="form-select form-select-sm status-select status-{{statusValue}}"
                                        onchange="this.form.submit()">
                                    {{#statuses}}
                                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                    {{/statuses}}
                                </select>
                            </form>
                        </td>
                        <td class="text-end pe-3">
                            <a href="/tasks/{{id}}/edit" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form action="/tasks/{{id}}/delete" method="post" class="d-inline"
                                  onsubmit="return confirm('Удалить «{{title}}»?')">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {{/globalTasks}}
                </tbody>
            </table>
        </div>
    </div>
    <!-- Мобилка -->
    <div class="d-md-none mb-4">
        {{#globalTasks}}
        <div class="card task-card mb-2 {{#overdue}}overdue{{/overdue}} {{#done}}done-card{{/done}}">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="fw-semibold">{{title}}</div>
                    <div class="d-flex gap-1 ms-2">
                        <a href="/tasks/{{id}}/edit" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form action="/tasks/{{id}}/delete" method="post"
                              onsubmit="return confirm('Удалить «{{title}}»?')">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
                {{#description}}
                <div class="text-muted small mb-2">{{description}}</div>
                {{/description}}
                {{#endDateOnly}}
                <div class="d-flex align-items-center gap-1 mb-2 small">
                    {{#overdue}}<i class="bi bi-exclamation-circle text-danger me-1"></i>{{/overdue}}
                    {{^overdue}}<i class="bi bi-flag me-1 text-muted"></i>{{/overdue}}
                    {{#overdue}}<span class="text-danger fw-semibold">{{endDateOnly}}</span>{{/overdue}}
                    {{^overdue}}<span class="text-muted">{{endDateOnly}}</span>{{/overdue}}
                    <form action="/tasks/{{id}}/end-time" method="post" class="d-inline ms-1">
                        <input type="time" name="time" value="{{endTime}}"
                               class="form-control form-control-sm time-inline d-inline {{#overdue}}border-danger{{/overdue}}"
                               onchange="this.form.submit()">
                    </form>
                </div>
                {{/endDateOnly}}
                <form action="/tasks/{{id}}/status" method="post">
                    <select name="status" class="form-select form-select-sm status-select status-{{statusValue}}"
                            onchange="this.form.submit()">
                        {{#statuses}}
                        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                        {{/statuses}}
                    </select>
                </form>
            </div>
        </div>
        {{/globalTasks}}
    </div>
    {{/hasGlobalTasks}}

    <!-- ===== ДНЕВНЫЕ ЗАДАЧИ ===== -->
    <div class="d-flex align-items-center justify-content-between mb-2">
        <span class="section-title text-secondary"><i class="bi bi-calendar-day me-1"></i>Дневные задачи</span>
        <a href="/tasks/new?type=DAILY" class="btn btn-sm btn-outline-secondary py-0">
            <i class="bi bi-plus-lg"></i>
        </a>
    </div>

    {{^hasDailyTasks}}
    <div class="card">
        <div class="text-center py-4 text-muted small">
            <i class="bi bi-calendar-day d-block fs-4 mb-1"></i>Нет дневных задач
        </div>
    </div>
    {{/hasDailyTasks}}

    {{#hasDailyTasks}}
    <!-- Десктоп -->
    <div class="card d-none d-md-block">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width:35%">Задача</th>
                        <th>Начало</th>
                        <th>Дедлайн</th>
                        <th>Статус</th>
                        <th class="text-end pe-3">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    {{#dailyTasks}}
                    <tr class="task-row {{#overdue}}overdue{{/overdue}} {{#done}}done-row{{/done}}">
                        <td class="ps-3">
                            <div class="fw-semibold">{{title}}</div>
                            {{#description}}
                            <div class="text-muted small text-truncate" style="max-width:280px">{{description}}</div>
                            {{/description}}
                        </td>
                        <td class="text-muted small">{{startDate}}</td>
                        <td>
                            <div class="d-flex align-items-center gap-1">
                                {{#overdue}}
                                <span class="text-danger fw-semibold small">
                                    <i class="bi bi-exclamation-circle me-1"></i>{{endDateOnly}}
                                </span>
                                {{/overdue}}
                                {{^overdue}}
                                <span class="text-muted small">{{endDateOnly}}</span>
                                {{/overdue}}
                                <form action="/tasks/{{id}}/end-time" method="post" class="d-inline">
                                    <input type="time" name="time" value="{{endTime}}"
                                           class="form-control form-control-sm time-inline {{#overdue}}border-danger{{/overdue}}"
                                           onchange="this.form.submit()">
                                </form>
                            </div>
                        </td>
                        <td>
                            <form action="/tasks/{{id}}/status" method="post" class="d-inline">
                                <select name="status" class="form-select form-select-sm status-select status-{{statusValue}}"
                                        onchange="this.form.submit()">
                                    {{#statuses}}
                                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                    {{/statuses}}
                                </select>
                            </form>
                        </td>
                        <td class="text-end pe-3">
                            <a href="/tasks/{{id}}/edit" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form action="/tasks/{{id}}/delete" method="post" class="d-inline"
                                  onsubmit="return confirm('Удалить «{{title}}»?')">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {{/dailyTasks}}
                </tbody>
            </table>
        </div>
    </div>
    <!-- Мобилка -->
    <div class="d-md-none">
        {{#dailyTasks}}
        <div class="card task-card mb-2 {{#overdue}}overdue{{/overdue}} {{#done}}done-card{{/done}}">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div class="fw-semibold">{{title}}</div>
                    <div class="d-flex gap-1 ms-2">
                        <a href="/tasks/{{id}}/edit" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form action="/tasks/{{id}}/delete" method="post"
                              onsubmit="return confirm('Удалить «{{title}}»?')">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
                {{#description}}
                <div class="text-muted small mb-2">{{description}}</div>
                {{/description}}
                <div class="d-flex flex-wrap gap-3 mb-2 small text-muted">
                    <span><i class="bi bi-play-circle me-1"></i>{{startDate}}</span>
                    <span>
                        {{#overdue}}<i class="bi bi-exclamation-circle text-danger me-1"></i>{{/overdue}}
                        {{^overdue}}<i class="bi bi-flag me-1"></i>{{/overdue}}
                        {{#overdue}}<span class="text-danger fw-semibold">{{endDateOnly}}</span>{{/overdue}}
                        {{^overdue}}{{endDateOnly}}{{/overdue}}
                        <form action="/tasks/{{id}}/end-time" method="post" class="d-inline ms-1">
                            <input type="time" name="time" value="{{endTime}}"
                                   class="form-control form-control-sm time-inline d-inline {{#overdue}}border-danger{{/overdue}}"
                                   onchange="this.form.submit()">
                        </form>
                    </span>
                </div>
                <form action="/tasks/{{id}}/status" method="post">
                    <select name="status" class="form-select form-select-sm status-select status-{{statusValue}}"
                            onchange="this.form.submit()">
                        {{#statuses}}
                        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                        {{/statuses}}
                    </select>
                </form>
            </div>
        </div>
        {{/dailyTasks}}
    </div>
    {{/hasDailyTasks}}

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>