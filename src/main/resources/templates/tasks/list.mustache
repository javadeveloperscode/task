<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Задачи</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        body { background-color: #f0f2f5; }
        .card { border: none; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,.08); }
        .stat-card { transition: transform .15s; }
        .stat-card:hover { transform: translateY(-2px); }
        .task-row.overdue td { background-color: #fff5f5; }
        .task-row.done-row td { opacity: .6; }
        .status-select { border-radius: 20px; font-size: .8rem; font-weight: 500; cursor: pointer; }
        .status-TODO { border-color: #6c757d; color: #6c757d; }
        .status-IN_PROGRESS { border-color: #0d6efd; color: #0d6efd; }
        .status-DONE { border-color: #198754; color: #198754; }
    </style>
</head>
<body>

<nav class="navbar navbar-dark bg-primary shadow-sm">
    <div class="container">
        <span class="navbar-brand fw-semibold">
            <i class="bi bi-check2-square me-2"></i>Задачник
        </span>
        <a href="/tasks/new" class="btn btn-light btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Новая задача
        </a>
    </div>
</nav>

<div class="container py-4">

    <!-- Статистика -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card stat-card text-center p-3">
                <div class="fs-2 fw-bold text-secondary">{{todoCount}}</div>
                <div class="text-muted small">К выполнению</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card text-center p-3">
                <div class="fs-2 fw-bold text-primary">{{inProgressCount}}</div>
                <div class="text-muted small">В работе</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card text-center p-3">
                <div class="fs-2 fw-bold text-success">{{doneCount}}</div>
                <div class="text-muted small">Готово</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card text-center p-3">
                <div class="fs-2 fw-bold text-danger">{{overdueCount}}</div>
                <div class="text-muted small">Просрочено</div>
            </div>
        </div>
    </div>

    <!-- Список задач -->
    <div class="card">
        <div class="card-body p-0">

            {{^hasTasks}}
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                <p class="mb-0">Задач пока нет.</p>
                <a href="/tasks/new" class="btn btn-primary mt-3">
                    <i class="bi bi-plus-lg me-1"></i>Создать первую
                </a>
            </div>
            {{/hasTasks}}

            {{#hasTasks}}
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width:38%">Задача</th>
                            <th>Начало</th>
                            <th>Дедлайн</th>
                            <th>Статус</th>
                            <th class="text-end pe-3">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#tasks}}
                        <tr class="task-row {{#overdue}}overdue{{/overdue}} {{#done}}done-row{{/done}}">
                            <td class="ps-3">
                                <div class="fw-semibold">{{title}}</div>
                                {{#description}}
                                <div class="text-muted small text-truncate" style="max-width:300px">{{description}}</div>
                                {{/description}}
                            </td>
                            <td class="text-muted">{{startDate}}</td>
                            <td>
                                {{#overdue}}
                                <span class="text-danger fw-semibold">
                                    <i class="bi bi-exclamation-circle me-1"></i>{{endDate}}
                                </span>
                                {{/overdue}}
                                {{^overdue}}{{endDate}}{{/overdue}}
                            </td>
                            <td>
                                <form action="/tasks/{{id}}/status" method="post" class="d-inline">
                                    <select name="status" class="form-select form-select-sm status-select status-{{statusValue}}"
                                            onchange="this.form.submit()" style="min-width:130px">
                                        {{#statuses}}
                                        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                        {{/statuses}}
                                    </select>
                                </form>
                            </td>
                            <td class="text-end pe-3">
                                <a href="/tasks/{{id}}/edit" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form action="/tasks/{{id}}/delete" method="post" class="d-inline"
                                      onsubmit="return confirm('Удалить задачу «{{title}}»?')">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {{/tasks}}
                    </tbody>
                </table>
            </div>
            {{/hasTasks}}

        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>