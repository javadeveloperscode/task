<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Задачник</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
            background: #f5f5f7;
            color: #1d1d1f;
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Navbar ── */
        .navbar {
            position: sticky; top: 0; z-index: 100;
            background: rgba(255,255,255,.82);
            backdrop-filter: saturate(180%) blur(20px);
            -webkit-backdrop-filter: saturate(180%) blur(20px);
            border-bottom: 1px solid rgba(0,0,0,.1);
            height: 48px;
            display: flex; align-items: center;
        }
        .navbar-inner {
            max-width: 980px; margin: 0 auto; padding: 0 22px;
            width: 100%; display: flex; justify-content: space-between; align-items: center;
        }
        .navbar-brand { font-size: 17px; font-weight: 600; color: #1d1d1f; text-decoration: none; }
        .navbar-actions { display: flex; align-items: center; gap: 10px; }

        /* ── Buttons ── */
        .btn {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 6px 14px; border-radius: 980px;
            font-size: 13px; font-weight: 500; cursor: pointer;
            border: none; text-decoration: none; transition: opacity .15s;
            white-space: nowrap;
        }
        .btn:hover { opacity: .82; }
        .btn-primary { background: #0071e3; color: #fff; }
        .btn-secondary { background: rgba(0,0,0,.06); color: #1d1d1f; }
        .btn-ghost { background: transparent; color: #6e6e73; border: 1px solid #d2d2d7; }
        .btn-icon { padding: 6px 10px; }
        .btn-danger-ghost { background: transparent; color: #ff3b30; border: 1px solid rgba(255,59,48,.3); }

        /* ── Streak ── */
        .streak {
            display: flex; align-items: center; gap: 5px;
            background: rgba(255,149,0,.12); border-radius: 980px;
            padding: 4px 12px; font-size: 14px; font-weight: 600; color: #ff9500;
        }
        .streak.zero { background: rgba(0,0,0,.05); color: #aeaeb2; }

        /* ── Container ── */
        .container { max-width: 980px; margin: 0 auto; padding: 40px 22px; }

        /* ── Stats ── */
        .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 40px; }
        .stat-card {
            background: #fff; border-radius: 18px; padding: 20px;
            box-shadow: 0 2px 12px rgba(0,0,0,.06);
            text-align: center;
        }
        .stat-num { font-size: 32px; font-weight: 700; line-height: 1; margin-bottom: 4px; }
        .stat-label { font-size: 12px; color: #6e6e73; font-weight: 500; }
        .stat-todo .stat-num   { color: #aeaeb2; }
        .stat-work .stat-num   { color: #0071e3; }
        .stat-done .stat-num   { color: #34c759; }
        .stat-over .stat-num   { color: #ff3b30; }

        /* ── Section ── */
        .section { margin-bottom: 40px; }
        .section-header {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 14px;
        }
        .section-title {
            font-size: 11px; font-weight: 700; letter-spacing: .06em;
            text-transform: uppercase; color: #6e6e73;
        }

        /* ── Task list ── */
        .task-list {
            background: #fff; border-radius: 18px;
            box-shadow: 0 2px 12px rgba(0,0,0,.06);
            overflow: hidden;
        }
        .task-item {
            display: grid; align-items: center;
            padding: 14px 20px;
            border-bottom: 1px solid rgba(0,0,0,.05);
            transition: background .12s;
        }
        .task-item:last-child { border-bottom: none; }
        .task-item:hover { background: #fafafa; }
        .task-item.daily-item { grid-template-columns: 1fr 120px 190px 150px auto; gap: 16px; }
        .task-item.global-item { grid-template-columns: 1fr 190px 150px auto; gap: 16px; }
        .task-item.overdue { background: #fff8f7; }
        .task-item.done-row { opacity: .55; }

        .task-header { display: grid; grid-template-columns: inherit; gap: inherit;
            padding: 10px 20px 8px; border-bottom: 1px solid rgba(0,0,0,.08); }
        .task-header span { font-size: 11px; font-weight: 600; color: #aeaeb2;
            text-transform: uppercase; letter-spacing: .05em; }

        .task-name { font-size: 15px; font-weight: 500; }
        .task-desc { font-size: 13px; color: #6e6e73; margin-top: 2px;
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 340px; }
        .task-date { font-size: 13px; color: #6e6e73; }
        .task-date.overdue-date { color: #ff3b30; font-weight: 500; }

        /* ── Deadline inline ── */
        .deadline-wrap { display: flex; align-items: center; gap: 6px; }
        .time-input {
            border: 1px solid #d2d2d7; border-radius: 8px;
            padding: 4px 8px; font-size: 13px; color: #1d1d1f;
            background: #fff; width: 86px; outline: none;
            font-family: inherit; transition: border-color .15s;
        }
        .time-input:focus { border-color: #0071e3; }
        .time-input.overdue-input { border-color: rgba(255,59,48,.4); color: #ff3b30; }

        /* ── Status select ── */
        .status-select {
            border: 1px solid #d2d2d7; border-radius: 980px;
            padding: 5px 12px; font-size: 13px; font-weight: 500;
            background: #fff; cursor: pointer; outline: none;
            font-family: inherit; transition: border-color .15s; appearance: none;
            -webkit-appearance: none; text-align: center;
        }
        .status-select:focus { border-color: #0071e3; }
        .status-select.s-TODO        { color: #aeaeb2; border-color: #d2d2d7; }
        .status-select.s-IN_PROGRESS { color: #0071e3; border-color: rgba(0,113,227,.4); }
        .status-select.s-DONE        { color: #34c759; border-color: rgba(52,199,89,.4); }

        /* ── Actions ── */
        .actions { display: flex; gap: 6px; justify-content: flex-end; }
        .action-btn {
            width: 30px; height: 30px; border-radius: 8px; border: none;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; font-size: 14px; transition: background .12s;
            text-decoration: none; background: transparent; color: #6e6e73;
        }
        .action-btn:hover { background: rgba(0,0,0,.06); }
        .action-btn.delete:hover { background: rgba(255,59,48,.1); color: #ff3b30; }

        /* ── Empty state ── */
        .empty {
            background: #fff; border-radius: 18px; box-shadow: 0 2px 12px rgba(0,0,0,.06);
            padding: 48px 24px; text-align: center; color: #aeaeb2;
        }
        .empty i { font-size: 36px; display: block; margin-bottom: 10px; }
        .empty p { font-size: 15px; margin-bottom: 16px; }

        /* ── Mobile ── */
        @media (max-width: 768px) {
            .container { padding: 24px 16px; }
            .stats-grid { grid-template-columns: repeat(2,1fr); gap: 10px; margin-bottom: 28px; }
            .stat-card { padding: 16px; border-radius: 14px; }
            .stat-num { font-size: 26px; }
            .task-item.daily-item,
            .task-item.global-item { grid-template-columns: 1fr; gap: 10px; padding: 16px; }
            .task-header { display: none; }
            .task-list { border-radius: 14px; }
            .actions { justify-content: flex-start; }
            .btn span { display: none; }
            .btn-icon span { display: none; }
        }
    </style>
</head>
<body>

<nav class="navbar">
    <div class="navbar-inner">
        <a href="/tasks" class="navbar-brand">Задачник</a>
        <div class="navbar-actions">
            <div class="streak {{^streak}}zero{{/streak}}">
                🔥 {{streak}}
            </div>
            <a href="/profile" class="btn btn-secondary">
                <i class="bi bi-person-circle"></i>
                <span>Профиль</span>
            </a>
            <a href="/tasks/new?type=GLOBAL" class="btn btn-secondary">
                <i class="bi bi-globe2"></i>
                <span>Глобальная</span>
            </a>
            <a href="/tasks/new?type=DAILY" class="btn btn-primary">
                <i class="bi bi-plus"></i>
                <span>Дневная</span>
            </a>
            <a href="/logout" class="btn btn-ghost btn-icon">
                <i class="bi bi-box-arrow-right"></i>
            </a>
        </div>
    </div>
</nav>

<div class="container">

    <!-- Статистика -->
    <div class="stats-grid">
        <div class="stat-card stat-todo">
            <div class="stat-num">{{todoCount}}</div>
            <div class="stat-label">К выполнению</div>
        </div>
        <div class="stat-card stat-work">
            <div class="stat-num">{{inProgressCount}}</div>
            <div class="stat-label">В работе</div>
        </div>
        <div class="stat-card stat-done">
            <div class="stat-num">{{doneCount}}</div>
            <div class="stat-label">Готово</div>
        </div>
        <div class="stat-card stat-over">
            <div class="stat-num">{{overdueCount}}</div>
            <div class="stat-label">Просрочено</div>
        </div>
    </div>

    <!-- Глобальные задачи -->
    <div class="section">
        <div class="section-header">
            <span class="section-title">Глобальные задачи</span>
            <a href="/tasks/new?type=GLOBAL" class="btn btn-ghost btn-icon"><i class="bi bi-plus"></i></a>
        </div>

        {{^hasGlobalTasks}}
        <div class="empty">
            <i class="bi bi-globe2"></i>
            <p>Нет глобальных задач</p>
            <a href="/tasks/new?type=GLOBAL" class="btn btn-primary">Добавить</a>
        </div>
        {{/hasGlobalTasks}}

        {{#hasGlobalTasks}}
        <div class="task-list">
            <div class="task-item global-item task-header">
                <span>Задача</span><span>Дедлайн</span><span>Статус</span><span></span>
            </div>
            {{#globalTasks}}
            <div class="task-item global-item {{#overdue}}overdue{{/overdue}} {{#done}}done-row{{/done}}">
                <div>
                    <div class="task-name">{{title}}</div>
                    {{#description}}<div class="task-desc">{{description}}</div>{{/description}}
                </div>
                <div class="deadline-wrap">
                    {{#endDateOnly}}
                    <span class="task-date {{#overdue}}overdue-date{{/overdue}}">{{endDateOnly}}</span>
                    <form action="/tasks/{{id}}/end-time" method="post">
                        <input type="time" name="time" value="{{endTime}}"
                               class="time-input {{#overdue}}overdue-input{{/overdue}}"
                               onchange="this.form.submit()">
                    </form>
                    {{/endDateOnly}}
                    {{^endDateOnly}}<span class="task-date">—</span>{{/endDateOnly}}
                </div>
                <form action="/tasks/{{id}}/status" method="post">
                    <select name="status" class="status-select s-{{statusValue}}" onchange="this.form.submit()">
                        {{#statuses}}
                        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                        {{/statuses}}
                    </select>
                </form>
                <div class="actions">
                    <a href="/tasks/{{id}}/edit" class="action-btn"><i class="bi bi-pencil"></i></a>
                    <form action="/tasks/{{id}}/delete" method="post" onsubmit="return confirm('Удалить «{{title}}»?')">
                        <button type="submit" class="action-btn delete"><i class="bi bi-trash"></i></button>
                    </form>
                </div>
            </div>
            {{/globalTasks}}
        </div>
        {{/hasGlobalTasks}}
    </div>

    <!-- Дневные задачи -->
    <div class="section">
        <div class="section-header">
            <span class="section-title">Дневные задачи</span>
            <a href="/tasks/new?type=DAILY" class="btn btn-ghost btn-icon"><i class="bi bi-plus"></i></a>
        </div>

        {{^hasDailyTasks}}
        <div class="empty">
            <i class="bi bi-calendar-day"></i>
            <p>Нет дневных задач</p>
            <a href="/tasks/new?type=DAILY" class="btn btn-primary">Добавить</a>
        </div>
        {{/hasDailyTasks}}

        {{#hasDailyTasks}}
        <div class="task-list">
            <div class="task-item daily-item task-header">
                <span>Задача</span><span>Начало</span><span>Дедлайн</span><span>Статус</span><span></span>
            </div>
            {{#dailyTasks}}
            <div class="task-item daily-item {{#overdue}}overdue{{/overdue}} {{#done}}done-row{{/done}}">
                <div>
                    <div class="task-name">{{title}}</div>
                    {{#description}}<div class="task-desc">{{description}}</div>{{/description}}
                </div>
                <span class="task-date">{{startDate}}</span>
                <div class="deadline-wrap">
                    {{#overdue}}
                    <span class="task-date overdue-date"><i class="bi bi-exclamation-circle" style="margin-right:3px"></i>{{endDateOnly}}</span>
                    {{/overdue}}
                    {{^overdue}}<span class="task-date">{{endDateOnly}}</span>{{/overdue}}
                    <form action="/tasks/{{id}}/end-time" method="post">
                        <input type="time" name="time" value="{{endTime}}"
                               class="time-input {{#overdue}}overdue-input{{/overdue}}"
                               onchange="this.form.submit()">
                    </form>
                </div>
                <form action="/tasks/{{id}}/status" method="post">
                    <select name="status" class="status-select s-{{statusValue}}" onchange="this.form.submit()">
                        {{#statuses}}
                        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                        {{/statuses}}
                    </select>
                </form>
                <div class="actions">
                    <a href="/tasks/{{id}}/edit" class="action-btn"><i class="bi bi-pencil"></i></a>
                    <form action="/tasks/{{id}}/delete" method="post" onsubmit="return confirm('Удалить «{{title}}»?')">
                        <button type="submit" class="action-btn delete"><i class="bi bi-trash"></i></button>
                    </form>
                </div>
            </div>
            {{/dailyTasks}}
        </div>
        {{/hasDailyTasks}}
    </div>

</div>
</body>
</html>