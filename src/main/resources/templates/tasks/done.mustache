<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Выполненное — Задачник</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
            background: #f5f5f7;
            color: #1d1d1f;
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Navbar ── */
        .navbar {
            position: sticky; top: 0; z-index: 100;
            background: rgba(255,255,255,.82);
            backdrop-filter: saturate(180%) blur(20px);
            -webkit-backdrop-filter: saturate(180%) blur(20px);
            border-bottom: 1px solid rgba(0,0,0,.1);
            height: 48px;
            display: flex; align-items: center;
        }
        .navbar-inner {
            max-width: 980px; margin: 0 auto; padding: 0 22px;
            width: 100%; display: flex; align-items: center; gap: 10px;
        }
        .navbar-back {
            display: flex; align-items: center; gap: 5px;
            font-size: 14px; color: #0071e3; text-decoration: none;
            padding: 4px 0; transition: opacity .15s;
        }
        .navbar-back:hover { opacity: .7; }
        .navbar-title { font-size: 17px; font-weight: 600; color: #1d1d1f; margin-left: 4px; }
        .navbar-count {
            font-size: 13px; color: #6e6e73; margin-left: 6px; font-weight: 400;
        }

        /* ── Container ── */
        .container { max-width: 980px; margin: 0 auto; padding: 40px 22px; }

        /* ── Section ── */
        .section-title {
            font-size: 11px; font-weight: 700; letter-spacing: .06em;
            text-transform: uppercase; color: #6e6e73;
            margin-bottom: 14px; display: block;
        }

        /* ── Task list ── */
        .task-list {
            background: #fff; border-radius: 18px;
            box-shadow: 0 2px 12px rgba(0,0,0,.06);
            overflow: hidden; margin-bottom: 40px;
        }
        .task-item {
            display: grid;
            grid-template-columns: minmax(0,1fr) 190px auto;
            gap: 16px; align-items: center;
            padding: 14px 20px;
            border-bottom: 1px solid rgba(0,0,0,.05);
            opacity: .6;
        }
        .task-item:last-child { border-bottom: none; }
        .task-header {
            display: grid; grid-template-columns: minmax(0,1fr) 190px auto;
            gap: 16px; padding: 10px 20px 8px;
            border-bottom: 1px solid rgba(0,0,0,.08);
            opacity: 1;
        }
        .task-header span { font-size: 11px; font-weight: 600; color: #aeaeb2;
            text-transform: uppercase; letter-spacing: .05em; }

        .task-name { font-size: 15px; font-weight: 500; text-decoration: line-through; color: #6e6e73;
            overflow-wrap: break-word; word-break: break-word; }
        .task-desc { font-size: 13px; color: #aeaeb2; margin-top: 2px;
            overflow-wrap: break-word; word-break: break-word; }
        .done-badge {
            display: inline-flex; align-items: center; gap: 5px;
            font-size: 13px; font-weight: 500; color: #34c759;
        }
        .task-date { font-size: 13px; color: #aeaeb2; }

        /* ── Actions ── */
        .actions { display: flex; gap: 6px; justify-content: flex-end; }
        .action-btn {
            width: 30px; height: 30px; border-radius: 8px; border: none;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; font-size: 14px; transition: background .12s;
            text-decoration: none; background: transparent; color: #aeaeb2;
        }
        .action-btn:hover { background: rgba(0,0,0,.06); color: #6e6e73; }
        .action-btn.delete:hover { background: rgba(255,59,48,.1); color: #ff3b30; }

        /* ── Empty ── */
        .empty {
            background: #fff; border-radius: 18px; box-shadow: 0 2px 12px rgba(0,0,0,.06);
            padding: 64px 24px; text-align: center; color: #aeaeb2;
        }
        .empty i { font-size: 40px; display: block; margin-bottom: 12px; }
        .empty p { font-size: 15px; }

        /* ── Mobile ── */
        @media (max-width: 768px) {
            .container { padding: 24px 16px; }
            .task-item, .task-header { grid-template-columns: 1fr; gap: 8px; padding: 14px 16px; }
            .task-header { display: none; }
            .task-list { border-radius: 14px; }
            .actions { justify-content: flex-start; }
        }
    </style>
</head>
<body>

<nav class="navbar">
    <div class="navbar-inner">
        <a href="/tasks" class="navbar-back"><i class="bi bi-chevron-left"></i> Задачи</a>
        <span class="navbar-title">Выполненное <span class="navbar-count">{{doneCount}}</span></span>
    </div>
</nav>

<div class="container">

    {{^hasDoneTasks}}
    <div class="empty">
        <i class="bi bi-check2-circle"></i>
        <p>Пока нет выполненных задач</p>
    </div>
    {{/hasDoneTasks}}

    {{#hasDoneTasks}}
    <div class="task-list">
        <div class="task-item task-header">
            <span>Задача</span><span>Выполнено</span><span></span>
        </div>
        {{#doneTasks}}
        <div class="task-item">
            <div>
                <div class="task-name">{{title}}</div>
                {{#description}}<div class="task-desc">{{description}}</div>{{/description}}
            </div>
            <div class="done-badge">
                <i class="bi bi-check-circle-fill"></i> Готово
            </div>
            <div class="actions">
                <form action="/tasks/{{id}}/delete" method="post" onsubmit="return confirm('Удалить «{{title}}»?')">
                    <button type="submit" class="action-btn delete"><i class="bi bi-trash"></i></button>
                </form>
            </div>
        </div>
        {{/doneTasks}}
    </div>
    {{/hasDoneTasks}}

</div>
</body>
</html>