<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Задачник</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet">
    <style>
        body { background-color: #f0f2f5; }
        .card { border: none; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,.08); }
        .form-control:focus, .form-select:focus { box-shadow: 0 0 0 .2rem rgba(13,110,253,.2); }
        .flatpickr-input { background-color: #fff !important; }
        @media (max-width: 576px) {
            .card { border-radius: 0; box-shadow: none; }
            .container { padding-left: 0; padding-right: 0; }
        }
    </style>
</head>
<body>

<nav class="navbar navbar-dark bg-primary shadow-sm">
    <div class="container">
        <a href="/tasks" class="navbar-brand fw-semibold">
            <i class="bi bi-check2-square me-2"></i>Задачник
        </a>
    </div>
</nav>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-7 col-lg-5">
            <div class="card p-4">

                {{#form}}

                <h5 class="fw-semibold mb-4">
                    {{#isNew}}<i class="bi bi-plus-circle text-primary me-2"></i>{{/isNew}}
                    {{^isNew}}<i class="bi bi-pencil-square text-primary me-2"></i>{{/isNew}}
                    {{formTitle}}
                </h5>

                {{#isNew}}
                <form action="/tasks" method="post">
                {{/isNew}}
                {{^isNew}}
                <form action="/tasks/{{taskId}}" method="post">
                {{/isNew}}

                    <div class="mb-3">
                        <label class="form-label fw-medium">Тип задачи</label>
                        <select name="type" id="typeSelect" class="form-select">
                            {{#types}}
                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                            {{/types}}
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-medium">Название <span class="text-danger">*</span></label>
                        <input type="text" name="title" class="form-control" value="{{title}}"
                               placeholder="Что нужно сделать?" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-medium">Описание</label>
                        <textarea name="description" class="form-control" rows="3"
                                  placeholder="Подробности задачи...">{{description}}</textarea>
                    </div>

                    <div id="startDateSection" class="row g-3 mb-3" {{#isGlobal}}style="display:none!important"{{/isGlobal}}>
                        <div class="col-12">
                            <label class="form-label fw-medium">Начало</label>
                            <input type="text" id="startDate" name="startDate" class="form-control"
                                   value="{{startDate}}" placeholder="Выберите дату и время">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-medium">Дедлайн</label>
                        <input type="text" id="endDate" name="endDate" class="form-control"
                               value="{{endDate}}" placeholder="Выберите дату и время">
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-medium">Статус</label>
                        <select name="status" class="form-select">
                            {{#statuses}}
                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                            {{/statuses}}
                        </select>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i>Сохранить
                        </button>
                        <a href="/tasks" class="btn btn-outline-secondary px-4">Отмена</a>
                    </div>

                </form>

                {{/form}}

            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/ru.js"></script>
<script>
    const pickerConfig = {
        enableTime: true,
        time_24hr: true,
        dateFormat: "Y-m-d\\TH:i",
        altInput: true,
        altFormat: "j M Y, H:i",
        locale: "ru",
        minuteIncrement: 5,
        disableMobile: true
    };
    flatpickr("#startDate", pickerConfig);
    flatpickr("#endDate", pickerConfig);

    // Скрывать/показывать даты при смене типа
    const typeSelect = document.getElementById("typeSelect");
    if (typeSelect) {
        typeSelect.addEventListener("change", function () {
            document.getElementById("startDateSection").style.display =
                this.value === "GLOBAL" ? "none" : "";
        });
    }
</script>
</body>
</html>