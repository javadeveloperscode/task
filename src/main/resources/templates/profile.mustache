<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Профиль — Задачник</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
            background: #f5f5f7;
            color: #1d1d1f;
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Navbar ── */
        .navbar {
            position: sticky; top: 0; z-index: 100;
            background: rgba(255,255,255,.82);
            backdrop-filter: saturate(180%) blur(20px);
            -webkit-backdrop-filter: saturate(180%) blur(20px);
            border-bottom: 1px solid rgba(0,0,0,.1);
            height: 48px;
            display: flex; align-items: center;
        }
        .navbar-inner {
            max-width: 980px; margin: 0 auto; padding: 0 22px;
            width: 100%; display: flex; justify-content: space-between; align-items: center;
        }
        .navbar-brand { font-size: 17px; font-weight: 600; color: #1d1d1f; text-decoration: none; }
        .navbar-actions { display: flex; align-items: center; gap: 10px; }
        .btn {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 6px 14px; border-radius: 980px;
            font-size: 13px; font-weight: 500; cursor: pointer;
            border: none; text-decoration: none; transition: opacity .15s;
        }
        .btn:hover { opacity: .82; }
        .btn-secondary { background: rgba(0,0,0,.06); color: #1d1d1f; }
        .btn-ghost { background: transparent; color: #6e6e73; border: 1px solid #d2d2d7; }
        .btn-icon { padding: 6px 10px; }
        .btn-active { background: rgba(0,113,227,.1); color: #0071e3; }

        .streak {
            display: flex; align-items: center; gap: 5px;
            background: rgba(255,149,0,.12); border-radius: 980px;
            padding: 4px 12px; font-size: 14px; font-weight: 600; color: #ff9500;
        }
        .streak.zero { background: rgba(0,0,0,.05); color: #aeaeb2; }

        /* ── Container ── */
        .container { max-width: 640px; margin: 0 auto; padding: 40px 22px; }

        /* ── Avatar block ── */
        .profile-hero {
            display: flex; align-items: center; gap: 20px;
            background: #fff; border-radius: 18px;
            box-shadow: 0 2px 12px rgba(0,0,0,.06);
            padding: 28px 32px; margin-bottom: 24px;
        }
        .avatar {
            width: 68px; height: 68px; border-radius: 50%;
            background: linear-gradient(145deg, #0071e3, #40a9ff);
            display: flex; align-items: center; justify-content: center;
            font-size: 28px; font-weight: 700; color: #fff;
            flex-shrink: 0;
        }
        .profile-info {}
        .profile-name { font-size: 22px; font-weight: 700; margin-bottom: 4px; }
        .profile-sub { font-size: 14px; color: #6e6e73; }

        /* ── Stats grid ── */
        .stats-grid {
            display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px;
            margin-bottom: 24px;
        }
        .stat-card {
            background: #fff; border-radius: 18px;
            box-shadow: 0 2px 12px rgba(0,0,0,.06);
            padding: 22px 24px;
        }
        .stat-icon { font-size: 24px; margin-bottom: 10px; }
        .stat-num { font-size: 36px; font-weight: 700; line-height: 1; margin-bottom: 4px; }
        .stat-label { font-size: 13px; color: #6e6e73; font-weight: 500; }

        .stat-done   .stat-num { color: #34c759; }
        .stat-missed .stat-num { color: #ff3b30; }
        .stat-work   .stat-num { color: #0071e3; }
        .stat-total  .stat-num { color: #1d1d1f; }

        /* ── Streak card ── */
        .streak-card {
            background: #fff; border-radius: 18px;
            box-shadow: 0 2px 12px rgba(0,0,0,.06);
            padding: 24px 32px;
            display: flex; align-items: center; justify-content: space-between;
        }
        .streak-left {}
        .streak-label { font-size: 13px; font-weight: 600; color: #6e6e73;
            text-transform: uppercase; letter-spacing: .05em; margin-bottom: 6px; }
        .streak-val {
            font-size: 40px; font-weight: 800; color: #ff9500; line-height: 1;
        }
        .streak-val.zero { color: #aeaeb2; }
        .streak-desc { font-size: 13px; color: #6e6e73; margin-top: 4px; }
        .streak-flame { font-size: 52px; line-height: 1; }

        /* ── Mobile ── */
        @media (max-width: 600px) {
            .container { padding: 20px 16px; }
            .profile-hero { padding: 20px; flex-direction: column; align-items: flex-start; gap: 14px; }
            .stats-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
            .stat-card { padding: 18px; }
            .stat-num { font-size: 30px; }
            .streak-card { padding: 20px; }
            .streak-val { font-size: 34px; }
        }
    </style>
</head>
<body>

<nav class="navbar">
    <div class="navbar-inner">
        <a href="/tasks" class="navbar-brand">Задачник</a>
        <div class="navbar-actions">
            <div class="streak {{^streak}}zero{{/streak}}">
                🔥 {{streak}}
            </div>
            <a href="/tasks" class="btn btn-secondary">
                <i class="bi bi-list-task"></i>
                <span>Задачи</span>
            </a>
            <a href="/logout" class="btn btn-ghost btn-icon">
                <i class="bi bi-box-arrow-right"></i>
            </a>
        </div>
    </div>
</nav>

<div class="container">

    <!-- Профиль -->
    <div class="profile-hero">
        <div class="avatar">{{usernameInitial}}</div>
        <div class="profile-info">
            <div class="profile-name">{{username}}</div>
            <div class="profile-sub">Личный кабинет</div>
        </div>
    </div>

    <!-- Статистика задач -->
    <div class="stats-grid">
        <div class="stat-card stat-done">
            <div class="stat-icon">🎯</div>
            <div class="stat-num">{{done}}</div>
            <div class="stat-label">Выполнено</div>
        </div>
        <div class="stat-card stat-missed">
            <div class="stat-icon">💨</div>
            <div class="stat-num">{{missed}}</div>
            <div class="stat-label">Пропущено</div>
        </div>
        <div class="stat-card stat-work">
            <div class="stat-icon">⚡️</div>
            <div class="stat-num">{{inProgress}}</div>
            <div class="stat-label">В работе</div>
        </div>
        <div class="stat-card stat-total">
            <div class="stat-icon">🗂</div>
            <div class="stat-num">{{total}}</div>
            <div class="stat-label">Всего задач</div>
        </div>
    </div>

    <!-- Стрик -->
    <div class="streak-card">
        <div class="streak-left">
            <div class="streak-label">Серия дней</div>
            <div class="streak-val {{^streak}}zero{{/streak}}">{{streak}}</div>
            <div class="streak-desc">дней подряд с выполненными задачами</div>
        </div>
        <div class="streak-flame">🔥</div>
    </div>

</div>
</body>
</html>