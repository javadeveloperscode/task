<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Профиль — Задачник</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
            background: #f5f5f7;
            color: #1d1d1f;
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Navbar ── */
        .navbar {
            position: sticky; top: 0; z-index: 100;
            background: rgba(255,255,255,.82);
            backdrop-filter: saturate(180%) blur(20px);
            -webkit-backdrop-filter: saturate(180%) blur(20px);
            border-bottom: 1px solid rgba(0,0,0,.1);
            height: 48px; display: flex; align-items: center;
        }
        .navbar-inner {
            max-width: 980px; margin: 0 auto; padding: 0 22px;
            width: 100%; display: flex; justify-content: space-between; align-items: center;
        }
        .navbar-brand { font-size: 17px; font-weight: 600; color: #1d1d1f; text-decoration: none; }
        .navbar-actions { display: flex; align-items: center; gap: 10px; }
        .btn {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 6px 14px; border-radius: 980px;
            font-size: 13px; font-weight: 500; cursor: pointer;
            border: none; text-decoration: none; transition: opacity .15s; white-space: nowrap;
        }
        .btn:hover { opacity: .82; }
        .btn-secondary { background: rgba(0,0,0,.06); color: #1d1d1f; }
        .btn-ghost { background: transparent; color: #6e6e73; border: 1px solid #d2d2d7; }
        .btn-icon { padding: 6px 10px; }
        .streak {
            display: flex; align-items: center; gap: 5px;
            background: rgba(255,149,0,.12); border-radius: 980px;
            padding: 4px 12px; font-size: 14px; font-weight: 600; color: #ff9500;
        }
        .streak.zero { background: rgba(0,0,0,.05); color: #aeaeb2; }

        /* ── Layout ── */
        .container { max-width: 720px; margin: 0 auto; padding: 40px 22px; }

        /* ── Profile hero ── */
        .profile-hero {
            display: flex; align-items: center; gap: 20px;
            background: #fff; border-radius: 18px;
            box-shadow: 0 2px 12px rgba(0,0,0,.06);
            padding: 28px 32px; margin-bottom: 20px;
        }
        .avatar {
            width: 64px; height: 64px; border-radius: 50%;
            background: linear-gradient(145deg, #0071e3, #40a9ff);
            display: flex; align-items: center; justify-content: center;
            font-size: 26px; font-weight: 700; color: #fff; flex-shrink: 0;
        }
        .profile-name { font-size: 22px; font-weight: 700; }
        .profile-sub { font-size: 14px; color: #6e6e73; margin-top: 3px; }

        /* ── Stats grid ── */
        .stats-grid {
            display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px;
            margin-bottom: 20px;
        }
        .stat-card {
            background: #fff; border-radius: 18px;
            box-shadow: 0 2px 12px rgba(0,0,0,.06);
            padding: 20px 16px;
        }
        .stat-icon-wrap {
            width: 36px; height: 36px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 18px; margin-bottom: 12px;
        }
        .stat-num { font-size: 32px; font-weight: 700; line-height: 1; margin-bottom: 4px; }
        .stat-label { font-size: 12px; color: #6e6e73; font-weight: 500; }

        .stat-done   .stat-icon-wrap { background: rgba(52,199,89,.12);  color: #34c759; }
        .stat-missed .stat-icon-wrap { background: rgba(255,59,48,.1);   color: #ff3b30; }
        .stat-work   .stat-icon-wrap { background: rgba(0,113,227,.1);   color: #0071e3; }
        .stat-total  .stat-icon-wrap { background: rgba(0,0,0,.05);      color: #6e6e73; }
        .stat-done   .stat-num { color: #34c759; }
        .stat-missed .stat-num { color: #ff3b30; }
        .stat-work   .stat-num { color: #0071e3; }
        .stat-total  .stat-num { color: #1d1d1f; }

        /* ── Streak card ── */
        .streak-card {
            background: #fff; border-radius: 18px;
            box-shadow: 0 2px 12px rgba(0,0,0,.06);
            padding: 24px 28px; margin-bottom: 20px;
            display: flex; align-items: center; justify-content: space-between;
        }
        .streak-label {
            font-size: 11px; font-weight: 700; color: #6e6e73;
            text-transform: uppercase; letter-spacing: .06em; margin-bottom: 6px;
        }
        .streak-val { font-size: 42px; font-weight: 800; color: #ff9500; line-height: 1; }
        .streak-val.zero { color: #aeaeb2; }
        .streak-desc { font-size: 13px; color: #6e6e73; margin-top: 5px; }
        .streak-icon {
            width: 52px; height: 52px; border-radius: 14px;
            background: rgba(255,149,0,.12);
            display: flex; align-items: center; justify-content: center;
            font-size: 26px; color: #ff9500;
        }
        .streak-icon.zero { background: rgba(0,0,0,.05); color: #aeaeb2; }

        /* ── Telegram card ── */
        .tg-card {
            background: #fff; border-radius: 18px;
            box-shadow: 0 2px 12px rgba(0,0,0,.06);
            padding: 24px 28px; margin-bottom: 20px;
        }
        .tg-header {
            display: flex; align-items: center; gap: 10px; margin-bottom: 16px;
        }
        .tg-icon {
            width: 36px; height: 36px; border-radius: 10px;
            background: rgba(0,136,212,.12);
            display: flex; align-items: center; justify-content: center;
            font-size: 18px; color: #0088d4; flex-shrink: 0;
        }
        .tg-title { font-size: 15px; font-weight: 600; }
        .tg-sub { font-size: 13px; color: #6e6e73; margin-top: 1px; }
        .tg-connected {
            display: inline-flex; align-items: center; gap: 5px;
            font-size: 12px; font-weight: 600; color: #34c759;
            background: rgba(52,199,89,.1); border-radius: 980px;
            padding: 3px 10px; margin-bottom: 12px;
        }
        .tg-row { display: flex; gap: 8px; }
        .tg-input {
            flex: 1; border: 1px solid #d2d2d7; border-radius: 10px;
            padding: 9px 13px; font-size: 14px; color: #1d1d1f;
            background: #fff; outline: none; font-family: inherit;
            transition: border-color .15s;
        }
        .tg-input:focus { border-color: #0071e3; box-shadow: 0 0 0 3px rgba(0,113,227,.15); }
        .tg-btn {
            padding: 9px 18px; border-radius: 10px; border: none;
            background: #0071e3; color: #fff; font-size: 14px; font-weight: 500;
            cursor: pointer; font-family: inherit; transition: opacity .15s; white-space: nowrap;
        }
        .tg-btn:hover { opacity: .85; }
        .tg-btn-detect { background: rgba(0,0,0,.06); color: #1d1d1f; }
        .tg-hint { font-size: 12px; color: #aeaeb2; margin-top: 10px; line-height: 1.5; }
        .tg-saved {
            font-size: 13px; color: #34c759; font-weight: 500;
            margin-top: 8px; display: flex; align-items: center; gap: 4px;
        }

        /* ── Chart card ── */
        .chart-card {
            background: #fff; border-radius: 18px;
            box-shadow: 0 2px 12px rgba(0,0,0,.06);
            padding: 24px 28px;
        }
        .chart-title {
            font-size: 11px; font-weight: 700; color: #6e6e73;
            text-transform: uppercase; letter-spacing: .06em; margin-bottom: 20px;
        }
        .chart-wrap { position: relative; height: 180px; }

        /* ── Mobile ── */
        @media (max-width: 600px) {
            .container { padding: 20px 16px; }
            .profile-hero { padding: 20px; gap: 14px; }
            .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
            .stat-num { font-size: 28px; }
            .streak-card { padding: 20px; }
            .streak-val { font-size: 36px; }
            .chart-card { padding: 20px; }
            .chart-wrap { height: 160px; }
        }
    </style>
</head>
<body>

<nav class="navbar">
    <div class="navbar-inner">
        <a href="/tasks" class="navbar-brand">Задачник</a>
        <div class="navbar-actions">
            <div class="streak {{^streak}}zero{{/streak}}">🔥 {{streak}}</div>
            <a href="/tasks" class="btn btn-secondary">
                <i class="bi bi-list-task"></i>
                <span>Задачи</span>
            </a>
            <a href="/logout" class="btn btn-ghost btn-icon">
                <i class="bi bi-box-arrow-right"></i>
            </a>
        </div>
    </div>
</nav>

<div class="container">

    <!-- Профиль -->
    <div class="profile-hero">
        <div class="avatar">{{usernameInitial}}</div>
        <div>
            <div class="profile-name">{{username}}</div>
            <div class="profile-sub">Личный кабинет</div>
        </div>
    </div>

    <!-- Статистика -->
    <div class="stats-grid">
        <div class="stat-card stat-done">
            <div class="stat-icon-wrap"><i class="bi bi-check-circle-fill"></i></div>
            <div class="stat-num">{{done}}</div>
            <div class="stat-label">Выполнено</div>
        </div>
        <div class="stat-card stat-missed">
            <div class="stat-icon-wrap"><i class="bi bi-x-circle-fill"></i></div>
            <div class="stat-num">{{missed}}</div>
            <div class="stat-label">Пропущено</div>
        </div>
        <div class="stat-card stat-work">
            <div class="stat-icon-wrap"><i class="bi bi-arrow-clockwise"></i></div>
            <div class="stat-num">{{inProgress}}</div>
            <div class="stat-label">В работе</div>
        </div>
        <div class="stat-card stat-total">
            <div class="stat-icon-wrap"><i class="bi bi-layers-fill"></i></div>
            <div class="stat-num">{{total}}</div>
            <div class="stat-label">Всего задач</div>
        </div>
    </div>

    <!-- Серия -->
    <div class="streak-card">
        <div>
            <div class="streak-label">Серия дней</div>
            <div class="streak-val {{^streak}}zero{{/streak}}">{{streak}}</div>
            <div class="streak-desc">дней подряд с выполненными задачами</div>
        </div>
        <div class="streak-icon {{^streak}}zero{{/streak}}">
            <i class="bi bi-fire"></i>
        </div>
    </div>

    <!-- Telegram -->
    <div class="tg-card">
        <div class="tg-header">
            <div class="tg-icon"><i class="bi bi-telegram"></i></div>
            <div>
                <div class="tg-title">Telegram уведомления</div>
                <div class="tg-sub">За 30 минут до начала задачи</div>
            </div>
        </div>
        {{#telegramConnected}}
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px">
            <div class="tg-connected" style="margin-bottom:0"><i class="bi bi-check-circle-fill"></i> Подключено</div>
            <button type="button" class="tg-btn tg-btn-detect" style="padding:4px 12px;font-size:12px" onclick="testTelegram()">Отправить тест</button>
        </div>
        {{/telegramConnected}}
        {{#telegramSaved}}
        <div class="tg-saved"><i class="bi bi-check-circle-fill"></i> Сохранено</div>
        {{/telegramSaved}}
        <form action="/profile/telegram" method="post">
            <div class="tg-row">
                <input type="text" id="tgChatId" name="chatId" class="tg-input"
                       value="{{telegramChatId}}" placeholder="Ваш Chat ID">
                <button type="button" class="tg-btn tg-btn-detect" onclick="detectChatId()">Определить</button>
                <button type="submit" class="tg-btn">Сохранить</button>
            </div>
        </form>
        <div id="tgDetectMsg" style="display:none" class="tg-hint"></div>
        <div class="tg-hint">
            Напишите боту любое сообщение → нажмите <b>Определить</b> → Chat ID заполнится автоматически.
        </div>

        <script>
        function testTelegram() {
            fetch('/profile/telegram/test', {method:'POST'})
                .then(r => r.json())
                .then(data => {
                    const msg = document.getElementById('tgDetectMsg');
                    msg.style.display = '';
                    msg.textContent = data.ok || data.error;
                });
        }
        function detectChatId() {
            const msg = document.getElementById('tgDetectMsg');
            msg.style.display = '';
            msg.textContent = 'Определяю...';
            fetch('/profile/telegram/detect')
                .then(r => r.json())
                .then(data => {
                    if (data.chatId) {
                        document.getElementById('tgChatId').value = data.chatId;
                        msg.textContent = '✓ Chat ID найден: ' + data.chatId;
                    } else {
                        msg.textContent = data.error || 'Не удалось определить';
                    }
                })
                .catch(() => { msg.textContent = 'Ошибка запроса'; });
        }
        </script>
    </div>

    <!-- График -->
    <div class="chart-card">
        <div class="chart-title">Выполнено задач по дням</div>
        <div class="chart-wrap">
            <canvas id="doneChart"></canvas>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
    const labels = {{{chartLabels}}};
    const data   = {{{chartData}}};

    const ctx = document.getElementById('doneChart').getContext('2d');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels,
            datasets: [{
                data,
                backgroundColor: 'rgba(0,113,227,.18)',
                borderColor: '#0071e3',
                borderWidth: 2,
                borderRadius: 6,
                borderSkipped: false,
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: ctx => ' ' + ctx.parsed.y + ' задач'
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: {
                        font: { family: '-apple-system, BlinkMacSystemFont, sans-serif', size: 11 },
                        color: '#aeaeb2',
                        maxRotation: 0,
                        autoSkip: true,
                        maxTicksLimit: 7,
                    }
                },
                y: {
                    beginAtZero: true,
                    ticks: {
                        stepSize: 1,
                        font: { family: '-apple-system, BlinkMacSystemFont, sans-serif', size: 11 },
                        color: '#aeaeb2',
                    },
                    grid: {
                        color: 'rgba(0,0,0,.04)',
                    }
                }
            }
        }
    });
</script>
</body>
</html>